# Local database containers. Replace every CHANGE_ME value in your private .env.
MONGO_INITDB_ROOT_USERNAME=mag_rag
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_PORT=10100
QDRANT_API_KEY=CHANGE_ME
QDRANT_HTTP_PORT=10060

# Dedicated thesis storage.
THESIS_MONGO_URI=mongodb://mag_rag:CHANGE_ME@127.0.0.1:10100/?authSource=admin
THESIS_MONGO_DB=mag_rag
THESIS_QDRANT_URL=http://127.0.0.1:10060
THESIS_QDRANT_COLLECTION=mag_rag_chunks

# Azure values are needed only for explicitly approved indexing/live runs.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDER=text-embedding-3-large
AZURE_OPENAI_EMBEDDER_DIM=3072
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=
